docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g) --platform linux/amd64 --init'
    fixOwnership = true
}

process {
    // The module uses the process_high label (12 CPUs by default in
    // conf/base.config), which exceeds the 8-core CI/local runner. Override
    // both the label and the process name so tests stay within limits.
    withLabel: process_high {
        cpus   = 2
        memory = '6.GB'
        time   = '6.h'
    }
    withName: CIRCLESEEKER {
        cpus   = 2
        memory = '6.GB'
        time   = '6.h'
        // conf/modules.config's publishDir references ${params.outdir},
        // which is null in module tests — disable publishing here.
        publishDir = [ enabled: false ]
    }
}
