nextflow_process {

    name "Test Process CIDERSEQ_ANNOTATE"
    script "../main.nf"
    process "CIDERSEQ_ANNOTATE"

    tag "modules"
    tag "modules_nfcore"
    tag "ciderseq"

    test("test-ciderseq-annotate") {

        options "-c ${projectDir}/modules/local/ciderseq/annotate/tests/nextflow.config"

        when {
            process {
                """
                input[0] = [ [ id:'example1', genome:'EACMV_DNA_A' ], // meta
                            file("\${projectDir}/modules/local/ciderseq/testdata/deconcat/example1.EACMV_DNA_A.fa", checkIfExists: true) ]
                input[1] = file("\${projectDir}/modules/local/ciderseq/testdata/ciderseq_config.json", checkIfExists: true)
                input[2] = file("\${projectDir}/modules/local/ciderseq/testdata/blastdb", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.annotation, process.out.versions).match() }
            )
        }

    }

}
