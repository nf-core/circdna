nextflow_process {

    name "Test Process ECC_FINDER_MAP_SR"
    script "../main.nf"
    process "ECC_FINDER_MAP_SR"

    tag "modules"
    tag "modules_nfcore"
    tag "ecc_finder"
    tag "ecc_finder/map_sr"

    test("test-map-sr - stub") {

        options "-stub -c ${projectDir}/modules/local/ecc_finder/map_sr/tests/nextflow.config"

        when {
            process {
                """
                input[0] = [ [ id:'ref' ], // meta
                            file("\${projectDir}/modules/local/ecc_finder/testdata/test_ref.fa.bwt", checkIfExists: true) ]
                input[1] = [ [ id:'test' ], // meta2
                            file("\${projectDir}/modules/local/ecc_finder/testdata/Arabi.1kReads.R1.fastq.gz", checkIfExists: true) ]
                input[2] = [ [ id:'test' ], // meta3
                            file("\${projectDir}/modules/local/ecc_finder/testdata/Arabi.1kReads.R2.fastq.gz", checkIfExists: true) ]
                input[3] = [ [ id:'ref' ], // meta4
                            file("\${projectDir}/modules/local/ecc_finder/testdata/test_ref.fa", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
