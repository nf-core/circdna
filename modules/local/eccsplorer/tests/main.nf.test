nextflow_process {

    name "Test Process ECCSPLORER"
    script "../main.nf"
    process "ECCSPLORER"

    tag "modules"
    tag "eccsplorer"

    test("eccsplorer - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                            [ file("\${projectDir}/modules/eccsplorer/testdata/test_reads_R1.fastq", checkIfExists: true),
                                file("\${projectDir}/modules/eccsplorer/testdata/test_reads_R2.fastq", checkIfExists: true) ],
                            file("\${projectDir}/modules/eccsplorer/testdata/test_ref.fa", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("eccsplorer - map mode - real run") {

        config './eccsplorer_map.config'

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                            [ file("\${projectDir}/modules/eccsplorer/testdata/test_reads_R1.fastq", checkIfExists: true),
                                file("\${projectDir}/modules/eccsplorer/testdata/test_reads_R2.fastq", checkIfExists: true) ],
                            file("\${projectDir}/modules/eccsplorer/testdata/test_ref.fa", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.candidates_bed.size() > 0 },
                { assert process.out.ecc_sequences.size() > 0 },
                { assert process.out.versions.size() > 0 },
                { assert snapshot(
                    process.out.versions
                ).match() }
            )
        }

    }

}
