{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/circdna//nextflow_schema.json",
    "title": "nf-core/circdna pipeline parameters",
    "description": "Pipeline for the identification of circular DNAs",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": ["input", "outdir"],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to comma-separated file containing information about the samples in the experiment.",
                    "help_text": "You will need to create a design file with information about the samples in your experiment before running the pipeline. Use this parameter to specify its location. It has to be a comma-separated file with 3 columns, and a header row.",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "validate_params": {
                    "type": "boolean",
                    "description": "Boolean whether to validate parameters against the schema at runtime",
                    "default": true,
                    "fa_icon": "fas fa-check-square",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "fa_icon": "far calendar",
                    "description": "Suffix to add to the trace report filename. Default is the date and time in the format yyyy-MM-dd_HH-mm-ss.",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ],
    "properties": {
        "input_format": {
            "type": "string"
        },
        "genome": {
            "type": "string"
        },
        "igenomes_base": {
            "type": "string",
            "default": "s3://ngi-igenomes/igenomes/"
        },
        "igenomes_ignore": {
            "type": "boolean"
        },
        "bwa_index": {
            "type": "string"
        },
        "save_reference": {
            "type": "boolean"
        },
        "bam_sorted": {
            "type": "boolean"
        },
        "save_sorted_bam": {
            "type": "boolean"
        },
        "use_csi_index": {
            "type": "boolean"
        },
        "circle_identifier": {
            "type": "string"
        },
        "eccfinder_engine": {
            "type": "string",
            "default": "blackbox"
        },
        "eccsplorer_engine": {
            "type": "string",
            "default": "blackbox"
        },
        "repex_databases": {
            "type": "string",
            "default": "/data1/users/siyangming/PublicDB/RepeatExplorer"
        },
        "eccsplorer_input_normalize": {
            "type": "boolean"
        },
        "eccsplorer_taxon": {
            "type": "string",
            "default": "vir"
        },
        "eccsplorer_all": {
            "type": "boolean"
        },
        "eccsplorer_trim_reads": {
            "type": "boolean"
        },
        "eccsplorer_database": {
            "type": "string"
        },
        "eccsplorer_map_core": {
            "type": "boolean"
        },
        "eccsplorer_map_extract": {
            "type": "boolean"
        },
        "eccsplorer_clu": {
            "type": "boolean"
        },
        "eccsplorer_trim_reads_opt": {
            "type": "string"
        },
        "eccsplorer_window_size": {
            "type": "integer",
            "default": 100
        },
        "eccsplorer_read_count": {
            "type": "string"
        },
        "eccsplorer_read_seed": {
            "type": "integer",
            "default": 12
        },
        "eccsplorer_image_format": {
            "type": "string",
            "default": "png"
        },
        "eccsplorer_viz_mode": {
            "type": "string",
            "default": "manhattan"
        },
        "eccsplorer_pre_a": {
            "type": "string",
            "default": "TR"
        },
        "eccsplorer_pre_b": {
            "type": "string",
            "default": "CO"
        },
        "eccsplorer_genome_size": {
            "type": "string"
        },
        "eccsplorer_max_cand_cnt": {
            "type": "integer",
            "default": 500
        },
        "eccsplorer_ecc_proportion": {
            "type": "number",
            "default": 0.8
        },
        "eccsplorer_clu_prefix_length": {
            "type": "integer",
            "default": 2
        },
        "eccsplorer_clu_taxon": {
            "type": "string",
            "default": "vir"
        },
        "eccfinder_peak_len": {
            "type": "integer",
            "default": 200
        },
        "eccfinder_max_dist": {
            "type": "integer",
            "default": 1000
        },
        "eccfinder_max_pvalue": {
            "type": "number",
            "default": 0.05
        },
        "eccfinder_min_reads": {
            "type": "integer",
            "default": 5
        },
        "eccfinder_asm_min_length": {
            "type": "integer",
            "default": 500
        },
        "eccfinder_ont_min_read": {
            "type": "integer",
            "default": 3
        },
        "eccfinder_ont_min_bound": {
            "type": "number",
            "default": 0.8
        },
        "eccfinder_ont_min_cov": {
            "type": "integer",
            "default": 10
        },
        "eccfinder_ont_min_query": {
            "type": "integer",
            "default": 200
        },
        "eccfinder_ont_min_align": {
            "type": "integer",
            "default": 200
        },
        "eccfinder_ont_copy": {
            "type": "integer",
            "default": 2
        },
        "eccfinder_ont_divergence": {
            "type": "number",
            "default": 0.25
        },
        "eccfinder_ont_period": {
            "type": "integer",
            "default": 30
        },
        "eccfinder_cdhit_identity": {
            "type": "number",
            "default": 0.8
        },
        "analysis_mode": {
            "type": "string"
        },
        "analysis_input": {
            "type": "string"
        },
        "detect_type": {
            "type": "string"
        },
        "protocol": {
            "type": "string",
            "default": "short_read"
        },
        "entrypoint": {
            "type": "string",
            "default": "cleaned_fastq"
        },
        "primers": {
            "type": "string"
        },
        "long_read_identifier": {
            "type": "string",
            "default": "cresil,fled,flye,eccfinder"
        },
        "min_read_support": {
            "type": "integer",
            "default": 1
        },
        "blacklist_bed": {
            "type": "string"
        },
        "repeats_bed": {
            "type": "string"
        },
        "save_long_read_intermediate": {
            "type": "boolean"
        },
        "skip_long_read_qc": {
            "type": "boolean"
        },
        "ccs_chunk_size": {
            "type": "integer",
            "default": 2
        },
        "assay": {
            "type": "string"
        },
        "remap_min_mapq": {
            "type": "integer",
            "default": 20
        },
        "remap_max_gap": {
            "type": "integer",
            "default": 100
        },
        "filter_organelle": {
            "type": "boolean"
        },
        "organelle_genome": {
            "type": "string"
        },
        "drop_organelle_candidates": {
            "type": "boolean"
        },
        "organelle_min_overlap": {
            "type": "number",
            "default": 0.5
        },
        "eccfinder_mode": {
            "type": "string",
            "default": "map"
        },
        "ciderseq_config": {
            "type": "string"
        },
        "ciderseq_blastdb": {
            "type": "string"
        },
        "ciderseq_align_targets": {
            "type": "string"
        },
        "ciderseq_protein_db": {
            "type": "string"
        },
        "ciderseq_host_genome": {
            "type": "string"
        },
        "mode": {
            "type": "string",
            "default": "eccdna"
        },
        "repeat_gff": {
            "type": "string"
        },
        "skip_qc": {
            "type": "boolean"
        },
        "clip_r1": {
            "type": "string"
        },
        "clip_r2": {
            "type": "string"
        },
        "three_prime_clip_r1": {
            "type": "string"
        },
        "three_prime_clip_r2": {
            "type": "string"
        },
        "trim_nextseq": {
            "type": "string"
        },
        "save_trimmed": {
            "type": "boolean"
        },
        "skip_trimming": {
            "type": "boolean"
        },
        "skip_markduplicates": {
            "type": "boolean"
        },
        "keep_duplicates": {
            "type": "boolean",
            "default": true
        },
        "save_markduplicates_bam": {
            "type": "boolean",
            "default": true
        },
        "cnvkit_cnn": {
            "type": "string"
        },
        "aa_data_repo": {
            "type": "string"
        },
        "aa_cngain": {
            "type": "number",
            "default": 4.5
        },
        "mosek_license_dir": {
            "type": "string"
        },
        "reference_build": {
            "type": "string"
        },
        "save_merged_fastq": {
            "type": "boolean"
        },
        "save_circle_map_intermediate": {
            "type": "boolean"
        },
        "save_circle_finder_intermediate": {
            "type": "boolean"
        },
        "save_unicycler_intermediate": {
            "type": "boolean"
        },
        "save_all_intermediates": {
            "type": "boolean"
        },
        "skip_multiqc": {
            "type": "boolean"
        },
        "multiqc_config": {
            "type": "string"
        },
        "multiqc_title": {
            "type": "string"
        },
        "multiqc_logo": {
            "type": "string"
        },
        "max_multiqc_email_size": {
            "type": "string",
            "default": "25.MB"
        },
        "multiqc_methods_description": {
            "type": "string"
        },
        "publish_dir_mode": {
            "type": "string",
            "default": "copy"
        },
        "email": {
            "type": "string"
        },
        "email_on_fail": {
            "type": "string"
        },
        "plaintext_email": {
            "type": "boolean"
        },
        "monochrome_logs": {
            "type": "boolean"
        },
        "hook_url": {
            "type": "string"
        },
        "config_profile_name": {
            "type": "string"
        },
        "config_profile_description": {
            "type": "string"
        },
        "custom_config_version": {
            "type": "string",
            "default": "master"
        },
        "custom_config_base": {
            "type": "string",
            "default": "https://raw.githubusercontent.com/nf-core/configs/master"
        },
        "config_profile_contact": {
            "type": "string"
        },
        "config_profile_url": {
            "type": "string"
        },
        "max_memory": {
            "type": "string",
            "default": "128.GB"
        },
        "max_cpus": {
            "type": "integer",
            "default": 16
        },
        "max_time": {
            "type": "string",
            "default": "240.h"
        },
        "validationFailUnrecognisedParams": {
            "type": "boolean"
        },
        "validationLenientMode": {
            "type": "boolean"
        },
        "validationSchemaIgnoreParams": {
            "type": "string",
            "default": "genomes,igenomes_base,analysis_input,analysis_mode,detect_type,eccfinder_asm_min_length,eccfinder_cdhit_identity,eccfinder_engine,eccfinder_max_dist,eccfinder_max_pvalue,eccfinder_min_reads,eccfinder_ont_copy,eccfinder_ont_divergence,eccfinder_ont_min_align,eccfinder_ont_min_bound,eccfinder_ont_min_cov,eccfinder_ont_min_query,eccfinder_ont_min_read,eccfinder_ont_period,eccfinder_peak_len,eccsplorer_all,eccsplorer_clu,eccsplorer_clu_prefix_length,eccsplorer_clu_taxon,eccsplorer_database,eccsplorer_ecc_proportion,eccsplorer_engine,eccsplorer_genome_size,eccsplorer_image_format,eccsplorer_input_normalize,eccsplorer_map_core,eccsplorer_map_extract,eccsplorer_max_cand_cnt,eccsplorer_pre_a,eccsplorer_pre_b,eccsplorer_read_count,eccsplorer_read_seed,eccsplorer_taxon,eccsplorer_trim_reads,eccsplorer_trim_reads_opt,eccsplorer_viz_mode,eccsplorer_window_size,repex_databases"
        },
        "validationShowHiddenParams": {
            "type": "boolean"
        },
        "fasta": {
            "type": "string"
        }
    }
}
