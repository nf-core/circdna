//
// 大基因组配置：使用 CSI 索引支持 >512Mb 染色体，并放宽长读引擎的资源上限
// 适用物种：Alopecurus_myosuroides（黑麦草）、Triticum_aestivum（小麦）等
// 用法: -profile server -c conf/large_genome.config
//

params {
    use_csi_index = true
}

process {
    // 精确覆盖 modules.config 中设了 ext.args = "" 的 alias
    withName: 'SAMTOOLS_INDEX_BAM' {
        ext.args = '-c'
    }
    withName: 'SAMTOOLS_INDEX_FILTERED' {
        ext.args = '-c'
    }
    withName: 'SAMTOOLS_INDEX_RE' {
        ext.args = '-c'
    }
    withName: 'SAMTOOLS_INDEX_REMAP' {
        ext.args = '-c'
    }
    withName: 'SAMTOOLS_INDEX_REFERENCE' {
        ext.args = '-c'
    }
    // BAM_MARKDUPLICATES_PICARD 内部的 SAMTOOLS_INDEX（modules.config 用正则匹配）
    withName: '.*BAM_MARKDUPLICATES_PICARD:SAMTOOLS_INDEX' {
        ext.args = '-c'
    }
}

//
// 资源上限覆盖
// -----------------
// conf/base.config 里的长读引擎默认值是按几 Gb 基因组定的，在 8 Gb 的小麦上会被
// cgroup OOM 杀掉（退出码 137）。实测（Alopecurus，3.6 Gb 基因组）峰值：
//   CRESIL_TRIM ~188 GB（默认只有 32 GB）
//   CRESIL_IDENTIFY / CRESIL_IDENTIFY_WGLS ~74 GB（默认 64 GB）
//   FLED ~16-32 GB（默认 32 GB）
// 小麦基因组更大，所以下面给出比实测更宽松的固定值。这里刻意不用
// `* task.attempt`：默认上限已经不够，靠重试翻倍只会白等一轮 OOM，而且
// 翻倍后会超过主机 503 GB 物理内存。
//
process {
    withName: 'CRESIL_TRIM' {
        cpus   = 16
        memory = 220.GB
        time   = 72.h
    }
    withName: 'CRESIL_IDENTIFY' {
        cpus   = 16
        memory = 140.GB
        time   = 96.h
    }
    withName: 'CRESIL_IDENTIFY_WGLS' {
        cpus   = 16
        memory = 140.GB
        time   = 96.h
    }
    // 默认走 process_low（12 GB），建 8 Gb 基因组的 mmi 远远不够
    withName: 'MINIMAP2_INDEX' {
        cpus   = 12
        memory = 96.GB
        time   = 24.h
    }
    withName: 'FLED' {
        cpus   = 12
        // 小麦最大样本实测峰值 >67 GB（默认 64 GB 会被 cgroup OOM 杀掉，
        // 退出码 137）。attempt 1 给 96 GB，重试翻倍到 192 GB。
        memory = { 96.GB * task.attempt }
        time   = 48.h
    }
}
