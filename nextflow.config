/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/circdna Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// Global default params, used in configs
params {
    // Input options
    input                      = null
    input_format               = null


    // References
    genome                      = null
    igenomes_base               = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore             = false

    // BWA Reference
    bwa_index                   = null
    save_reference              = false

    // BAM Sorted
    bam_sorted                  = false
    save_sorted_bam             = false
    use_csi_index               = false

    // Circular DNA identification options
    circle_identifier           = null

    // 引擎开关（slim | blackbox 并存；默认 blackbox，slim 对照一致后切默认）
    eccfinder_engine            = 'blackbox'
    eccsplorer_engine           = 'blackbox'

    // RepeatExplorer2 seqclust 外部数据库目录（conda 模式经 REPEX_DATABASES 软链；docker 模式镜像内置）
    repex_databases             = '/data1/users/siyangming/PublicDB/RepeatExplorer'

    // ECCsplorer slim 参数（对齐完整版 CLI，附表2；slim 链运行必需）
    eccsplorer_input_normalize  = false       // 新语义：输入标准化
    eccsplorer_taxon            = 'vir'       // clu 模式物种分类：vir（植物）/ met（动物）
    eccsplorer_all              = false       // 预留：全流程重型模式，默认关闭
    eccsplorer_trim_reads       = false       // 兼容旧参数别名
    eccsplorer_database         = null        // BLAST annotation database
    eccsplorer_map_core         = false
    eccsplorer_map_extract      = false
    eccsplorer_clu              = false
    eccsplorer_trim_reads_opt   = null        // -trm: nex|tru2|tru3|tru3-2|custom
    eccsplorer_window_size      = 100         // -win: 窗口大小
    eccsplorer_read_count       = null        // -cnt: null|auto|int
    eccsplorer_read_seed        = 12          // 子采样随机种子（原版 PIPELINE_SEED）
    eccsplorer_image_format     = 'png'       // -img: png|jpeg|bmp|tiff|pdf
    eccsplorer_viz_mode         = 'manhattan' // 可视化模式：manhattan | line
    eccsplorer_pre_a            = 'TR'        // -dsa: 数据集A前缀
    eccsplorer_pre_b            = 'CO'        // -dsb: 数据集B前缀
    eccsplorer_genome_size      = null        // -rgs: 基因组大小（auto 模式）
    eccsplorer_max_cand_cnt     = 500         // 候选数量上限
    eccsplorer_ecc_proportion   = 0.8         // clu 候选 TR 比例阈值
    eccsplorer_clu_prefix_length = 2          // seqclust --prefix_length（保留序列名前缀长度；TR/CO 样本前缀为 2，过大会使 comparative_counts 列数超 SQLite 限制）
    eccsplorer_clu_taxon        = 'vir'       // seqclust --taxon 物种（vir/met）

    // ecc_finder slim 参数（对齐完整版 map-sr.py / map-ont.py / asm-sr.py）
    eccfinder_peak_len          = 200         // map-sr -l: 最小峰长
    eccfinder_max_dist          = 1000        // map-sr -d: 峰最大间距
    eccfinder_max_pvalue        = 0.05        // map-sr -p: 最大 p 值
    eccfinder_min_reads         = 5           // map-sr --min-read
    eccfinder_asm_min_length    = 500         // asm-sr 最小 contig 长度
    eccfinder_ont_min_read      = 3           // map-ont --min-read
    eccfinder_ont_min_bound     = 0.8         // map-ont --min-bound
    eccfinder_ont_min_cov       = 10          // map-ont --min-cov
    eccfinder_ont_min_query     = 200         // map-ont -q: 最小 query 长度
    eccfinder_ont_min_align     = 200         // map-ont -a: 最小比对长度
    eccfinder_ont_copy          = 2           // asm-ont TideHunter -c
    eccfinder_ont_divergence    = 0.25        // asm-ont TideHunter -e
    eccfinder_ont_period        = 30          // asm-ont TideHunter -p
    eccfinder_cdhit_identity    = 0.8         // asm-ont cd-hit-est -c

    analysis_mode               = null
    analysis_input              = null
    detect_type                 = null

    // Long-read sequencing options
    protocol                    = 'short_read'
    entrypoint                  = 'cleaned_fastq'
    primers                     = null
    long_read_identifier        = 'cresil,fled,flye,eccfinder'
    // 长读 eccDNA 最小读支持数。长读（ONT/PacBio）单条 read 跨越环化接点本身
    // 就是有效证据，junction 支持数普遍为 1；旧默认值 2 会把绝大多数候选
    // （尤其 FLEd junction）全部滤掉，导致 long_read/filtering 终集几乎为空。
    min_read_support            = 1
    blacklist_bed               = null
    repeats_bed                 = null
    save_long_read_intermediate = false
    skip_long_read_qc           = false
    ccs_chunk_size              = 2   // GB: PacBio subreads BAM 分块大小（PBCCS 分块模式）

    // 路由字段（§1.1 / §6.1）：assay 仅当 samplesheet 缺省时回填，默认 null 强制行上填写长读
    assay                       = null

    // remap（§4.5）：无坐标组装物回贴参考的参数
    remap_min_mapq              = 20   // collapse_circle_alignments.py --min-mapq
    remap_max_gap               = 100  // collapse_circle_alignments.py --max-gap

    // organelle tag（§4.7）：默认只打 origin 列，不丢候选
    filter_organelle            = false
    organelle_genome            = null
    drop_organelle_candidates   = false
    organelle_min_overlap       = 0.5

    // ecc_finder options (fourth eccDNA detection engine)
    eccfinder_mode              = 'map'   // map | asm | both

    // ciderseq options (sixth eccDNA detection engine, long-read)
    ciderseq_config             = null    // CIDER-Seq2 config JSON
    ciderseq_blastdb            = null    // directory (or db file) of the blastn database
    ciderseq_align_targets      = null    // directory of the align target fasta files
    ciderseq_protein_db         = null    // directory (or db file) of the tblastn protein database
    ciderseq_host_genome        = null    // host genome for optional cs-eccDNA detection

    // Mode options
    mode                        = 'eccdna'     // 'reference', 'eccdna'
    repeat_gff                  = null          // EDTA/RepeatMasker GFF3/BED file path

    // FASTQC options
    skip_qc                     = false

    // Trimming options
    clip_r1                     = null
    clip_r2                     = null
    three_prime_clip_r1         = null
    three_prime_clip_r2         = null
    trim_nextseq                = null
    save_trimmed                = false
    skip_trimming               = false

    // Picard Markduplicates options
    skip_markduplicates         = false
    keep_duplicates             = true
    save_markduplicates_bam     = true

    // AmpliconArchitect options
    cnvkit_cnn                  = null
    aa_data_repo                = null
    aa_cngain                   = 4.5
    mosek_license_dir           = null
    reference_build             = null

    // Save Intermediate Files
    save_merged_fastq               = false
    save_circle_map_intermediate    = false
    save_circle_finder_intermediate = false
    save_unicycler_intermediate     = false
    save_all_intermediates          = false

    // MultiQC options
    skip_multiqc               = false
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                     = null
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = System.getenv('HOOK_URL')
    help                       = false
    version                    = false
    trace_report_suffix        = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    // Schema validation default options
    validate_params                  = true

}

// nf-schema plugin configuration (migrated from nf-validation params)
// Note: nf-schema 2.x never fails on unrecognised params (warns only),
// so the old `validationFailUnrecognisedParams = false` option was dropped.
validation {
    lenientMode            = false
    // legacy/分析参数不进 schema 校验（跳过，避免 invalid input 警告）
    defaultIgnoreParams    = ['genomes', 'igenomes_base', 'analysis_input', 'analysis_mode', 'detect_type', 'eccfinder_asm_min_length', 'eccfinder_cdhit_identity', 'eccfinder_engine', 'eccfinder_max_dist', 'eccfinder_max_pvalue', 'eccfinder_min_reads', 'eccfinder_ont_copy', 'eccfinder_ont_divergence', 'eccfinder_ont_min_align', 'eccfinder_ont_min_bound', 'eccfinder_ont_min_cov', 'eccfinder_ont_min_query', 'eccfinder_ont_min_read', 'eccfinder_ont_period', 'eccfinder_peak_len', 'eccsplorer_all', 'eccsplorer_clu', 'eccsplorer_clu_prefix_length', 'eccsplorer_clu_taxon', 'eccsplorer_database', 'eccsplorer_ecc_proportion', 'eccsplorer_engine', 'eccsplorer_genome_size', 'eccsplorer_image_format', 'eccsplorer_input_normalize', 'eccsplorer_map_core', 'eccsplorer_map_extract', 'eccsplorer_max_cand_cnt', 'eccsplorer_pre_a', 'eccsplorer_pre_b', 'eccsplorer_read_count', 'eccsplorer_read_seed', 'eccsplorer_taxon', 'eccsplorer_trim_reads', 'eccsplorer_trim_reads_opt', 'eccsplorer_viz_mode', 'eccsplorer_window_size', 'repex_databases']
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Load nf-core/circdna custom profiles from different institutions.
// Warning: Uncomment only if a pipeline-specific institutional config already exists on nf-core/configs!
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/circdna.config" : "/dev/null"

// Load modules.config for DSL2 module specific options (before profiles to allow profile overrides)
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        conda.channels         = ['conda-forge', 'bioconda']
        apptainer.enabled      = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    docker {
        docker.enabled         = true
        conda.enabled          = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
        docker.runOptions      = '-u $(id -u):$(id -g)'
        docker.fixOwnership    = true
    }
    arm64 {
        process.arch            = 'arm64'
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    podman {
        podman.enabled         = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    shifter {
        shifter.enabled        = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    charliecloud {
        charliecloud.enabled   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    gitpod {
        executor.name          = 'local'
        executor.cpus          = 4
        executor.memory        = 8.GB
    }
    test            { includeConfig 'conf/test.config'            }
    test_AA         { includeConfig 'conf/test_AA.config'         }
    test_AA_local   { includeConfig 'conf/test_AA_local.config'   }
    test_local      { includeConfig 'conf/test_local.config'      }
    test_full       { includeConfig 'conf/test_full.config'       }
    test_pacbio_lr  { includeConfig 'conf/test_pacbio_lr.config'  }
    test_nanopore_lr{ includeConfig 'conf/test_nanopore_lr.config'}
    test_ciderseq_local { includeConfig 'conf/test_ciderseq_local.config' }
    test_local_gdna { includeConfig 'conf/test_local_gdna.config' }
    test_mixed_assay{ includeConfig 'conf/test_mixed_assay.config'}
    test_lr_wgs     { includeConfig 'conf/test_lr_wgs.config'     }
    test_mixed_sr   { includeConfig 'conf/test_mixed_sr.config'   }
    test_bam_local  { includeConfig 'conf/test_bam_local.config'  }
    server          { includeConfig 'conf/server.config'          }
}

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'
// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
// wave {
//     enabled = true
//     strategy = ['container', 'container']
// }

manifest {
    name            = 'nf-core/circdna'
    author          = """siyangming"""
    homePage        = 'https://github.com/SiYangming/circdna.nf'
    description     = """Pipeline for the identification of circular DNAs"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.8'
    version = '4.7.7'
    doi             = '10.5281/zenodo.7712010'
}

